APP_DISPLAY_NAME = Parakeet
PRODUCT_BUNDLE_IDENTIFIER = com.aarzamen.ichirp
// v1.0 frozen 2026-11-05 (docs/SCOPE.md). CFBundleVersion is stamped per build by scripts/stamp_build_identity.sh;
// this is the only place the version is set, and every target's Info.plist reads $(MARKETING_VERSION).
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1
IPHONEOS_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
TARGETED_DEVICE_FAMILY = 1,2
CODE_SIGN_STYLE = Automatic
#include? "Signing.local.xcconfig"
